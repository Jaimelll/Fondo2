# Copia este archivo a .env.local (desarrollo) o .env (Docker) y completa los valores.
# La aplicación NO usa Supabase: corre 100% sobre Postgres propio. Las variables
# SUPABASE_* de más abajo solo las necesitan los scripts de migración, y dejan
# de hacer falta después del corte a fondo2.

# Postgres
# - Desde el host (npm run dev sin Docker): usa localhost:5434 (puerto mapeado en docker-compose.yml)
# - Desde el contenedor "app" (docker compose up): usa el host interno "db" en el puerto 5432
DATABASE_URL=postgresql://fondo2:fondo2@localhost:5434/fondo2

# Auth (Better-Auth)
# BETTER_AUTH_SECRET: genera uno propio, ej. `openssl rand -base64 32`. No reutilices este placeholder.
BETTER_AUTH_SECRET=reemplaza-esto-con-un-secreto-generado
BETTER_AUTH_URL=http://localhost:8082

# Storage de PDFs (módulo Documentos Corporativos)
# Ruta dentro del contenedor/host donde se guardan los archivos subidos.
STORAGE_DOCUMENTS_PATH=./storage/documentos

# App
PORT=3000
HOSTNAME=0.0.0.0

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — SOLO para los scripts de migración mientras el 8081 siga vivo:
# actualizar_desde_supabase.ps1, actualizar_bd_servidor.sh, dump_supabase.sh,
# backup_diario.ps1, migrar_usuarios.ps1 y archivar_buckets_supabase.sh.
# Estos valores estuvieron escritos dentro de los scripts, que están en un repo
# PÚBLICO: la contraseña debe rotarse en el panel de Supabase
# (Settings → Database → Reset database password) y vivir solo aquí.
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_DB_HOST=aws-1-us-east-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=postgres.xxxxxxxxxxxx
SUPABASE_DB_PASSWORD=

# Solo para archivar_buckets_supabase.sh (listar los buckets de Storage)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
